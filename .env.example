# ===========================================
# TeleFlow Platform — Environment Configuration
# ===========================================

# -------------------------------------------
# Общие настройки
# -------------------------------------------
COMPOSE_PROJECT_NAME=teleflow
TZ=Europe/Moscow

# -------------------------------------------
# PostgreSQL
# -------------------------------------------
POSTGRES_USER=teleflow
POSTGRES_PASSWORD=teleflow_secure_password_change_me
POSTGRES_DB=teleflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URLs (для сервисов)
# Формат: postgresql+asyncpg://user:pass@host:port/dbname

# -------------------------------------------
# Redis
# -------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# -------------------------------------------
# JWT Settings
# -------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# -------------------------------------------
# Auth Service
# -------------------------------------------
AUTH_SERVICE_URL=http://auth-service:8001
AUTH_JWT_SECRET=${JWT_SECRET}

# -------------------------------------------
# Content Service
# -------------------------------------------
CONTENT_SERVICE_URL=http://content-service:8002
CONTENT_DATABASE_URL=postgresql+asyncpg://teleflow:teleflow_secure_password_change_me@postgres:5432/content_db

# -------------------------------------------
# Publishing Service
# -------------------------------------------
PUBLISHING_SERVICE_URL=http://publishing-service:8004
PUBLISHING_DATABASE_URL=postgresql+asyncpg://teleflow:teleflow_secure_password_change_me@postgres:5432/publish_db

# -------------------------------------------
# Funnel Service
# -------------------------------------------
FUNNEL_SERVICE_URL=http://funnel-service:8005
FUNNEL_DATABASE_URL=postgresql+asyncpg://teleflow:teleflow_secure_password_change_me@postgres:5432/funnel_db

# -------------------------------------------
# Bot Gateway
# -------------------------------------------
BOT_GATEWAY_SERVICE_URL=http://bot-gateway:8006
BOT_DATABASE_URL=postgresql+asyncpg://teleflow:teleflow_secure_password_change_me@postgres:5432/bot_db
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_BOT_WEBHOOK_URL=https://your-domain.com/api/v1/bot/webhook

# -------------------------------------------
# Userbot Service
# -------------------------------------------
USERBOT_SERVICE_URL=http://userbot-service:8007
USERBOT_DATABASE_URL=postgresql+asyncpg://teleflow:teleflow_secure_password_change_me@postgres:5432/userbot_db
USERBOT_ENCRYPTION_KEY=your-32-byte-encryption-key-here!

# -------------------------------------------
# Promotion Service
# -------------------------------------------
PROMOTION_SERVICE_URL=http://promotion-service:8008
PROMOTION_DATABASE_URL=postgresql+asyncpg://teleflow:teleflow_secure_password_change_me@postgres:5432/promo_db

# -------------------------------------------
# AI Service
# -------------------------------------------
AI_SERVICE_URL=http://ai-service:8009
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OLLAMA_BASE_URL=http://ollama:11434

# -------------------------------------------
# Analytics Service
# -------------------------------------------
ANALYTICS_SERVICE_URL=http://analytics-service:8010
ANALYTICS_DATABASE_URL=postgresql+asyncpg://teleflow:teleflow_secure_password_change_me@postgres:5432/analytics_db

# -------------------------------------------
# Meilisearch
# -------------------------------------------
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_API_KEY=your-meilisearch-api-key-here

# -------------------------------------------
# MinIO (S3-compatible storage)
# -------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=teleflow

# -------------------------------------------
# Traefik
# -------------------------------------------
TRAEFIK_DASHBOARD_AUTH=admin:admin  # Change in production!
DOMAIN=localhost

# -------------------------------------------
# Monitoring
# -------------------------------------------
PROMETHEUS_SCRAPE_INTERVAL=15s
GRAFANA_ADMIN_PASSWORD=admin

# -------------------------------------------
# Frontend
# -------------------------------------------
VITE_API_BASE_URL=http://localhost/api/v1
VITE_WS_URL=ws://localhost/ws
